MODEL:
! Definición de variables binarias y enteras;
@FOR(VARIABLE_DECISION: @BIN(BX));
@FOR(VARIABLE_ARRANQUE_ASIGNATURA: @BIN(BXA));
@FOR(VARIABLE_PENALIZACION_BLOQUE: @BIN(BZ));
@FOR(VARIABLE_HORARIO_ESPECIAL: @BIN(BHE));
@FOR(VARIABLE_HORAS_LIBRES: @GIN(EHE));
@FOR(VARIABLE_ARRANQUE_PROCOM: @BIN(BY));

! FUNCIÓN OBJETIVO;
! Minimiza traslados de docentes compartidos y penaliza clases de 1 hora en lugar de bloques;
MIN = @SUM(GRU(g): @SUM(ASIDUPGRU(g,a): @SUM(DIA(d): BZ(a,g,d)) * penalizacion2))
    + @SUM(SED(s): @SUM(PROCOMSED(s,p): @SUM(DIA(d): @SUM(TIE(t): BY(p,s,d,t))) * penalizacion1));

! RESTRICCIONES;
! 1. Cobertura de la jornada normal;
@FOR(SED(s): @FOR(TIEJNODIA(d,t): @FOR(GRUSED(s,g): [RUNO]
    @SUM(BASE(p,a,g,s): BX(p,a,g,s,d,t)) = 1)));

! 2. Cobertura máxima en jornada extendida;
@FOR(SED(s): @FOR(TIEJEXDIA(d,t): @FOR(GRUJEXSED(s,g): [RDOS]
    @SUM(PROJEXSED(s,p): @SUM(BASE(p,a,g,s): BX(p,a,g,s,d,t))) <= 1)));

! 3. Continuidad en jornada extendida;
@FOR(SED(s): @FOR(DIA(d): @FOR(TIE(t) | t #EQ# 7: @FOR(GRUJEXSED(s,g): [RTRES]
    @SUM(PROJEXSED(s,p): @SUM(BASE(p,a,g,s): BX(p,a,g,s,d,t+1))) <= 
    @SUM(PROJEXSED(s,p): @SUM(BASE(p,a,g,s): BX(p,a,g,s,d,t)))))));

! 4. Un profesor solo dicta una clase por período;
@FOR(PRO(p): @FOR(TIEDIA(d,t): [RCUATRO]
    @SUM(BASE(p,a,g,s): BX(p,a,g,s,d,t)) <= 1));

! 5. Límite de horas diarias por docente;
@FOR(PRO(p): @FOR(DIA(d): [RCINCO]
    @SUM(TIE(t): @SUM(BASE(p,a,g,s): BX(p,a,g,s,d,t))) <= ntd));

! 6. Cumplimiento de intensidad horaria;
@FOR(GRU(g): @FOR(ASIGRU(g,a): [RSEISUNO]
    @SUM(DIA(d): @SUM(TIE(t): @SUM(BASE(p,a,g,s): BX(p,a,g,s,d,t)))) = iag(g,a)));

! (Sección de arranque y bloques omitida por brevedad, sigue lógica similar);

! 10. Tiempo de traslado entre sedes;
@FOR(PROCOM(p) | p #NE# 16: @FOR(DIA(d): @FOR(TIE(t) | t #LE# 7: [RDIEZUNO]
    @SUM(BASE(p,a,g,s) | s #EQ# 1: BX(p,a,g,s,d,t)) + 
    @SUM(BASE(p,a,g,s) | s #EQ# 2: BX(p,a,g,s,dw,t+1)) <= 1)));

! 13. Restricciones para Horario Especial (PROHES);
@FOR(SED(s): @FOR(PROHESPSED(s,p): [RTRECEUNO]
    @SUM(DIA(d): BHE(p,s,d)) = 1/2 * ntpphes(s,p)));

DATA:
    ntd = 6;
    npc = 2;
    penalizacion1 = 2;
    penalizacion2 = 1;
ENDDATA
END